# Telegram Bot Configuration
# Obtain your bot token from @BotFather on Telegram
BOT_TOKEN=your_telegram_bot_token_here

# Sorsa API Configuration
# Get your API keys from https://sorsa.io
# You can paste multiple keys separated by commas, spaces, or newlines:
SORSA_API_KEYS=key_1, key_2, key_3
# (Backward compatible: single key also works)
# SORSA_API_KEY=your_single_sorsa_key_here

SORSA_API_BASE_URL=https://api.sorsa.io/v3

# Bot Settings
ASSIGNMENT_COUNT=15
DATABASE_PATH=engagement_bot.db

# Admin User IDs (comma separated Telegram IDs, optional)
ADMIN_IDS=
